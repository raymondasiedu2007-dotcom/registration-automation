TELEGRAM_BOT_TOKEN=123456:replace_me
CONFIG_PATH=config.yaml
BOT_LOCK_FILE=/tmp/registration-automation-bot.lock

# AI Configuration - Single Model Mode (legacy)
AI_API_KEY=replace_me
AI_BASE_URL=https://api.moonshot.ai/v1
AI_MODEL=kimi-k2

# AI Configuration - Concurrent Mode with Kimi and Qwen
# Kimi (Moonshot AI) - https://platform.moonshot.ai/
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2

# Qwen (Alibaba) - https://dashscope.aliyuncs.com/
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# reCAPTCHA Solver Configuration
# Optional: CapSolver API key for solving image challenges (https://www.capsolver.com/)
CAPSOLVER_API_KEY=
# Optional: reCAPTCHA v3 solve timeout in seconds (default: 30)
RECAPTCHA_V3_TIMEOUT=30
# Optional: reCAPTCHA v2 solve attempts (default: 5)
RECAPTCHA_V2_ATTEMPTS=5
